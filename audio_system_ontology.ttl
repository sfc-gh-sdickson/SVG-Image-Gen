@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix audio: <http://example.org/audio-system#> .
@prefix device: <http://example.org/audio-devices#> .
@prefix connection: <http://example.org/audio-connections#> .

# Audio System Ontology
# Updated based on complete PipeWire configuration and graph analysis

# Class Definitions
audio:AudioDevice a owl:Class ;
    rdfs:label "Audio Device" ;
    rdfs:comment "A physical or virtual audio device in the system" .

audio:AudioSink a owl:Class ;
    rdfs:subClassOf audio:AudioDevice ;
    rdfs:label "Audio Sink" ;
    rdfs:comment "An audio output device or virtual sink" .

audio:AudioSource a owl:Class ;
    rdfs:subClassOf audio:AudioDevice ;
    rdfs:label "Audio Source" ;
    rdfs:comment "An audio input device or virtual source" .

audio:HardwareSink a owl:Class ;
    rdfs:subClassOf audio:AudioSink ;
    rdfs:label "Hardware Sink" ;
    rdfs:comment "A physical audio output device" .

audio:VirtualSink a owl:Class ;
    rdfs:subClassOf audio:AudioSink ;
    rdfs:label "Virtual Sink" ;
    rdfs:comment "A virtual audio sink created by software" .

audio:MixerSink a owl:Class ;
    rdfs:subClassOf audio:VirtualSink ;
    rdfs:label "Mixer Sink" ;
    rdfs:comment "A virtual sink that mixes multiple audio inputs" .

audio:StreamOutput a owl:Class ;
    rdfs:subClassOf audio:AudioDevice ;
    rdfs:label "Stream Output" ;
    rdfs:comment "An audio stream output from applications" .

audio:StreamInput a owl:Class ;
    rdfs:subClassOf audio:AudioDevice ;
    rdfs:label "Stream Input" ;
    rdfs:comment "An audio stream input to applications" .

audio:VideoSource a owl:Class ;
    rdfs:subClassOf audio:AudioSource ;
    rdfs:label "Video Source" ;
    rdfs:comment "A video device with audio capabilities" .

audio:AudioConnection a owl:Class ;
    rdfs:label "Audio Connection" ;
    rdfs:comment "A connection between audio devices" .

audio:ProcessingChain a owl:Class ;
    rdfs:label "Processing Chain" ;
    rdfs:comment "A chain of audio processing devices" .

# Object Properties
audio:hasConnection a owl:ObjectProperty ;
    rdfs:label "has connection" ;
    rdfs:domain audio:AudioDevice ;
    rdfs:range audio:AudioConnection .

audio:hasInput a owl:ObjectProperty ;
    rdfs:label "has input" ;
    rdfs:domain audio:AudioDevice ;
    rdfs:range audio:AudioSource .

audio:hasOutput a owl:ObjectProperty ;
    rdfs:label "has output" ;
    rdfs:domain audio:AudioDevice ;
    rdfs:range audio:AudioSink .

audio:processesAudio a owl:ObjectProperty ;
    rdfs:label "processes audio" ;
    rdfs:domain audio:AudioDevice ;
    rdfs:range audio:AudioDevice .

audio:belongsToChain a owl:ObjectProperty ;
    rdfs:label "belongs to chain" ;
    rdfs:domain audio:AudioDevice ;
    rdfs:range audio:ProcessingChain .

audio:hasSource a owl:ObjectProperty ;
    rdfs:label "has source" ;
    rdfs:domain audio:AudioConnection ;
    rdfs:range audio:AudioDevice .

audio:hasTarget a owl:ObjectProperty ;
    rdfs:label "has target" ;
    rdfs:domain audio:AudioConnection ;
    rdfs:range audio:AudioDevice .

# Data Properties
audio:hasVolume a owl:DatatypeProperty ;
    rdfs:label "has volume" ;
    rdfs:domain audio:AudioDevice ;
    rdfs:range xsd:integer .

audio:hasSampleRate a owl:DatatypeProperty ;
    rdfs:label "has sample rate" ;
    rdfs:domain audio:AudioDevice ;
    rdfs:range xsd:integer .

audio:hasState a owl:DatatypeProperty ;
    rdfs:label "has state" ;
    rdfs:domain audio:AudioDevice ;
    rdfs:range xsd:string .

audio:hasDeviceID a owl:DatatypeProperty ;
    rdfs:label "has device ID" ;
    rdfs:domain audio:AudioDevice ;
    rdfs:range xsd:string .

audio:hasDescription a owl:DatatypeProperty ;
    rdfs:label "has description" ;
    rdfs:domain audio:AudioDevice ;
    rdfs:range xsd:string .

audio:hasDriver a owl:DatatypeProperty ;
    rdfs:label "has driver" ;
    rdfs:domain audio:AudioDevice ;
    rdfs:range xsd:string .

audio:hasMediaClass a owl:DatatypeProperty ;
    rdfs:label "has media class" ;
    rdfs:domain audio:AudioDevice ;
    rdfs:range xsd:string .

