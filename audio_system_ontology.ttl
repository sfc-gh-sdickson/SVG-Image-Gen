# System State
audio:hasVolumeSyncDaemon a owl:DatatypeProperty ;
    rdfs:label "has volume sync daemon" ;
    rdfs:range xsd:boolean .

audio:hasQJackCtl a owl:DatatypeProperty ;
    rdfs:label "has QJackCtl running" ;
    rdfs:range xsd:boolean .

audio:current_system_state a owl:Thing ;
    audio:hasVolumeSyncDaemon false ;
    audio:hasQJackCtl true ;
    rdfs:label "Current Audio System State" .
